# ----- Server -----
NODE_ENV=development
PORT=4000

# Comma-separated allowlist of frontend origins (user, merchant, admin apps).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ----- Database (PostgreSQL) -----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopwave?schema=public

# ----- Auth -----
# Use a long random string in production: `openssl rand -base64 48`
JWT_SECRET=super-secret-change-me-in-production
JWT_EXPIRES_IN=7d
# Cookie name that stores the JWT (httpOnly)
COOKIE_NAME=token
# Cookie name for the anonymous guest-cart session id (pre-login carts, httpOnly)
CART_COOKIE_NAME=cart_sid
# Prod only: parent domain so the cookie is shared across subdomains, e.g. .app.com
# COOKIE_DOMAIN=.app.com
