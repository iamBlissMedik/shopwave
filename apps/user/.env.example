# Base URL of the Express API (note the /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Server-side only (optional): the API's internal address, used when pages are
# rendered on the server. Defaults to NEXT_PUBLIC_API_URL. In production, point
# it at the private network address so SSR calls skip the public load balancer
# (the API then sees the visitor's IP via X-Forwarded-For).
# API_URL=http://api.internal:4000/api

# Server-side only (optional, default 1): how many proxies sit in front of THIS
# Next server (load balancer, CDN, Vercel's edge…). SSR forwards the visitor's IP
# to the API, read from that many hops back in X-Forwarded-For; entries further
# left are client-supplied and ignored, so rate limits can't be dodged with a
# forged header. In production, always run Next behind at least one proxy.
# TRUSTED_PROXY_HOPS=1

# Public origin of the storefront — canonical URLs, Open Graph and sitemap.xml.
SITE_URL=http://localhost:3000
