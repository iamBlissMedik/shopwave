# Base URL of the Express API (note the /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Server-side only (optional): the API's internal address, used when pages are
# rendered on the server. Defaults to NEXT_PUBLIC_API_URL. In production, point
# it at the private network address so SSR calls skip the public load balancer
# (the API then sees the visitor's IP via X-Forwarded-For).
# API_URL=http://api.internal:4000/api

# Public origin of the storefront — canonical URLs, Open Graph and sitemap.xml.
SITE_URL=http://localhost:3000
