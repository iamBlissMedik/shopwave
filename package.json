{
  "name": "shopwave",
  "version": "1.0.0",
  "private": true,
  "description": "Shopwave — production-grade MVP marketplace monorepo (Next.js + Express + Prisma) managed with Turborepo",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "storybook": "pnpm --filter @shopwave/ui storybook",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @shopwave/api db:migrate",
    "db:seed": "pnpm --filter @shopwave/api db:seed",
    "db:studio": "pnpm --filter @shopwave/api db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3"
  }
}
